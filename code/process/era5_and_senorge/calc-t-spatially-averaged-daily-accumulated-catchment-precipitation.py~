"""
Create a time series of X-day accumulated, catchment-weighted spatial mean
precipitation for either SeNorge or ERA5.

- SeNorge is read year-by-year because files are large.
- ERA5 is read with open_mfdataset because files are smaller.
- Variable names, dimensions, units, and filenames are handled by dataset config.
"""

import numpy as np
import xarray as xr
import matplotlib.pyplot as plt
from Dunnsigouin_etal_2026 import config, misc


# input -----------------------------------------------------------------
dataset    = "senorge"   # "senorge" or "era5"
years      = np.arange(1957, 1958, 1)
x_days     = 2
catchment  = "regine_drammen"
write2file = True
plot       = False

# ERA5-only options
grid       = "0.5x0.5"
domain     = "norway"
# -----------------------------------------------------------------------


DATASET_CONFIG = {
    "senorge": {
        "variable": "rr",
        "path_in": config.dirs["senorge_continuous_daily"] + "rr/",
        "file_pattern": "rr_{year}.nc",
        "path_weights": lambda catchment: (
            config.dirs["nve_catchment"]
            + f"weights_catchment_{catchment}_senorge.nc"
        ),
        "path_out": config.dirs["senorge_processed"],
        "spatial_dims": ("Y", "X"),
        "read_mode": "yearly",
        "output_dataset_name": "senorge",
    },
    "era5": {
        "variable": "tp24",
        "path_in": config.dirs["era5_continuous_daily"] + "tp24/",
        "file_pattern": "tp24_{grid}_{year}.nc",
        "path_weights": lambda catchment: (
            config.dirs["nve_catchment"]
            + f"weights_catchment_{catchment}_era5_{grid}.nc"
        ),
        "path_out": config.dirs["era5_processed"],
        "spatial_dims": ("latitude", "longitude"),
        "read_mode": "mfdataset",
        "output_dataset_name": "era5",
    },
}


def preprocess_func(ds: xr.Dataset) -> xr.Dataset:
    """ERA5 preprocessing before combining files."""
    return ds.drop_vars("number", errors="ignore")


def standardize_precip_units(da: xr.DataArray, variable: str) -> xr.DataArray:
    """
    Convert precipitation to daily mm where needed.

    SeNorge rr is usually kg/m^2, equivalent to mm.
    ERA5 tp24 is usually in m/day and is converted to mm/day.
    """

    units = str(da.attrs.get("units", "")).strip().lower()

    if variable == "tp24":
        da = da * 1000.0
        da.attrs["units"] = "mm/day"

    elif units in {"kg/m^2", "kg/m2", "kg m-2"}:
        da.attrs["units"] = "mm"

    return da


def load_weights(path_weights: str, spatial_dims: tuple[str, str]) -> xr.DataArray:
    """Load catchment weights."""

    wds = xr.open_dataset(path_weights)

    if "catchment_weight" not in wds:
        raise KeyError(
            f"'catchment_weight' not found in {path_weights}. "
            f"Available variables: {list(wds.data_vars)}"
        )

    w = wds["catchment_weight"].astype("float32")
    w.name = "catchment_weight"

    missing_dims = [dim for dim in spatial_dims if dim not in w.dims]
    if missing_dims:
        raise ValueError(
            f"Weights are missing expected dimensions {missing_dims}. "
            f"Got dims {w.dims}."
        )

    return w


def load_one_year(
    path_in: str,
    year: int,
    variable: str,
    file_pattern: str,
    spatial_dims: tuple[str, str],
) -> xr.DataArray:
    """Load one yearly file, used for large datasets such as SeNorge."""

    filename = path_in + file_pattern.format(year=year)
    ds = xr.open_dataset(filename)
    ds = xr.decode_cf(ds)

    if variable not in ds:
        raise KeyError(
            f"'{variable}' not found in {filename}. "
            f"Available variables: {list(ds.data_vars)}"
        )

    da = ds[variable]

    fill_value = da.attrs.get("_FillValue", None)
    if fill_value is not None:
        da = da.where(da != fill_value)

    da = standardize_precip_units(da, variable)

    expected_dims = ("time", *spatial_dims)
    missing_dims = [dim for dim in expected_dims if dim not in da.dims]
    if missing_dims:
        raise ValueError(
            f"{filename} is missing expected dimensions {missing_dims}. "
            f"Got dims {da.dims}."
        )

    ds.close()
    return da


def load_all_years(
    path_in: str,
    years: np.ndarray,
    variable: str,
    file_pattern: str,
    grid: str | None = None,
    domain: str | None = None,
) -> xr.DataArray:
    """Load all years at once, used for smaller datasets such as ERA5."""

    filenames = [
        path_in + file_pattern.format(year=int(year), grid=grid)
        for year in years
    ]

    ds = xr.open_mfdataset(
        filenames,
        preprocess=preprocess_func,
        combine="by_coords",
    )

    if domain is not None:
        domain_lats, domain_lons = misc.get_domain_latlon(domain)
        ds = ds.sel(latitude=domain_lats, longitude=domain_lons)

    if variable not in ds:
        raise KeyError(
            f"'{variable}' not found. Available variables: {list(ds.data_vars)}"
        )

    da = standardize_precip_units(ds[variable], variable)

    return da


def align_weights_to_data(
    da: xr.DataArray,
    w: xr.DataArray,
) -> xr.DataArray:
    """Try coordinate-aware alignment first, then fall back to dim broadcasting."""

    spatial_template = da.isel(time=0, drop=True)

    try:
        return w.reindex_like(spatial_template, method=None)
    except Exception:
        return w.broadcast_like(spatial_template)


def catchment_weighted_mean_timeseries(
    da: xr.DataArray,
    w: xr.DataArray,
    spatial_dims: tuple[str, str],
    output_name: str,
    load_result: bool = False,
) -> xr.DataArray:
    """
    Weighted spatial mean time series:

        sum(w * precip) / sum(w)

    NaN-safe and restricted to positive catchment weights.
    """

    w = align_weights_to_data(da, w)

    valid = xr.ufuncs.isfinite(da) & xr.ufuncs.isfinite(w) & (w > 0)

    da_masked = da.where(valid)
    w_masked = w.where(valid)

    num = (da_masked * w_masked).sum(dim=spatial_dims, skipna=True)
    den = w_masked.sum(dim=spatial_dims, skipna=True)

    ts = num / den

    if load_result:
        ts = ts.load()

    ts.name = output_name
    ts.attrs["description"] = (
        "Catchment-weighted spatial mean of daily accumulated precipitation"
    )
    ts.attrs["units"] = da.attrs.get("units", "")

    return ts


def xday_accum_timeseries(
    ts: xr.DataArray,
    x_days: int,
    keep_full_windows_only: bool = True,
) -> xr.DataArray:
    """Trailing X-day rolling precipitation sum."""

    min_periods = x_days if keep_full_windows_only else 1

    out = ts.rolling(time=x_days, min_periods=min_periods).sum()

    if keep_full_windows_only:
        out = out.dropna("time", how="any")

    in_units = ts.attrs.get("units", "").strip().lower()

    if in_units in {"mm/day", "mm", "kg/m^2", "kg/m2", "kg m-2"}:
        out_units = "mm"
    else:
        out_units = ts.attrs.get("units", "")

    out.name = f"{ts.name}_{x_days}dayacc"
    out.attrs["description"] = (
        f"{x_days}-day accumulated catchment-weighted mean precipitation"
    )
    out.attrs["units"] = out_units

    return out


def plot_timeseries(ts: xr.DataArray, title: str | None = None) -> None:
    """Simple line plot of a 1D time series."""

    if "time" not in ts.dims:
        raise ValueError("Input must have 'time' dimension.")

    plt.figure(figsize=(10, 4))
    plt.plot(ts["time"].values, ts.values)

    plt.xlabel("Time")

    units = ts.attrs.get("units", "")
    ylabel = f"{ts.name} ({units})" if units else ts.name
    plt.ylabel(ylabel)

    if title is not None:
        plt.title(title)

    plt.tight_layout()
    plt.show()


def build_daily_timeseries(
    dataset: str,
    years: np.ndarray,
    catchment: str,
    grid: str | None = None,
    domain: str | None = None,
) -> tuple[xr.DataArray, dict]:

    cfg = DATASET_CONFIG[dataset]

    variable = cfg["variable"]
    spatial_dims = cfg["spatial_dims"]
    path_weights = cfg["path_weights"](catchment)

    w = load_weights(path_weights, spatial_dims)

    if cfg["read_mode"] == "yearly":
        ts_list = []

        for year in years:
            print(year)

            da_year = load_one_year(
                path_in=cfg["path_in"],
                year=int(year),
                variable=variable,
                file_pattern=cfg["file_pattern"],
                spatial_dims=spatial_dims,
            )

            ts_year = catchment_weighted_mean_timeseries(
                da=da_year,
                w=w,
                spatial_dims=spatial_dims,
                output_name=f"{variable}_daily_catchment_mean",
                load_result=True,
            )

            ts_list.append(ts_year)

        ts_daily = xr.concat(ts_list, dim="time").sortby("time")

    elif cfg["read_mode"] == "mfdataset":
        da = load_all_years(
            path_in=cfg["path_in"],
            years=years,
            variable=variable,
            file_pattern=cfg["file_pattern"],
            grid=grid,
            domain=domain,
        )

        ts_daily = catchment_weighted_mean_timeseries(
            da=da,
            w=w,
            spatial_dims=spatial_dims,
            output_name=f"{variable}_daily_catchment_mean",
            load_result=False,
        )

    else:
        raise ValueError(f"Unknown read_mode: {cfg['read_mode']}")

    ts_daily.name = f"{variable}_daily_catchment_mean"

    return ts_daily, cfg


if __name__ == "__main__":

    ts_daily_mean, cfg = build_daily_timeseries(
        dataset=dataset,
        years=years,
        catchment=catchment,
        grid=grid,
        domain=domain if dataset == "era5" else None,
    )

    variable = cfg["variable"]

    ts_xday_acc = xday_accum_timeseries(ts_daily_mean,x_days=x_days)

    # Standardized output variable name for both SeNorge and ERA5
    ts_xday_acc.name = "tp"
    ts_xday_acc.attrs["description"] = (
        f"{x_days}-day accumulated catchment-weighted mean precipitation"
    )
    ts_xday_acc.attrs["units"] = "mm"

    out = xr.Dataset({"tp": ts_xday_acc})

    
    if write2file:
        if dataset == "era5":
            filename_out = (
                f"{cfg['path_out']}"
                f"tp_{x_days}dayacc_nve_catchment_"
                f"{catchment}_{dataset}_{grid}_{years[0]}-{years[-1]}.nc"
            )
        else:
            filename_out = (
                f"{cfg['path_out']}"
                f"tp_{x_days}dayacc_nve_catchment_"
                f"{catchment}_{dataset}_{years[0]}-{years[-1]}.nc"
            )

        out.to_netcdf(filename_out)
        print("Wrote:", filename_out)
