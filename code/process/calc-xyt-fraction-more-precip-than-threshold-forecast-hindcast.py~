"""
Calculates an x,y,month file with the fraction of ensemble members in all forecast/hindcasts
with x-day accumulated precipitation > a user-defined threshold (mm over acc_days).

The key idea is to look at how the frequency of threshold-exceedance events varies by gridpoint.
"""

import numpy               as np
import xarray              as xr
import pandas              as pd
from Dunnsigouin_etal_2026 import config, misc

# input ----------------------------------------
variable            = "tp24"
acc_days            = 2
domain              = "norway"
forecast_date_range = ["2020-01-02", "2023-06-26"]
rain_threshold_mm   = 50
path_in_forecast    = config.dirs["s2s_forecast_daily"] + variable + "/"
path_in_hindcast    = config.dirs["s2s_hindcast_daily"] + variable + "/"
path_out            = config.dirs["s2s_processed"]
write2file          = True
# ----------------------------------------------


def accumulate_along_dim(ds, acc_days, dim="time"):
    """
    Rolling N-step accumulation along `dim` (default: time).
    Returns only complete accumulations (drops the first acc_days-1 steps).
    """
    if acc_days < 1:
        raise ValueError("acc_days must be >= 1")
    if dim not in ds.dims:
        raise ValueError(f"'{dim}' is not a dimension of the dataset.")

    out = ds.rolling({dim: acc_days}, min_periods=acc_days).sum()
    out = out.dropna(dim=dim, how="all")
    return out


def get_forecast_dates(forecast_date_range, option="mt"):
    """
    Generate a list of forecast dates within a given date range.

    option:
      'mt'  -> Mondays and Thursdays
      'all' -> all calendar days
    """
    start_date = pd.to_datetime(forecast_date_range[0])
    end_date   = pd.to_datetime(forecast_date_range[1])

    if option == "mt":
        mondays   = pd.date_range(start_date, end_date, freq="W-MON")
        thursdays = pd.date_range(start_date, end_date, freq="W-THU")
        forecast_dates = mondays.union(thursdays)
    else:
        forecast_dates = pd.date_range(start_date, end_date, freq="D")

    return forecast_dates.sort_values().strftime("%Y-%m-%d").tolist()


def read_accumulated_model_data(variable, date, path_in_model, acc_days, domain):
    """
    Read model data for one init date, subset to domain, accumulate along time.
    Returns DataArray with dims like (time, number, latitude, longitude) and for hindcast also hdate.
    """
    domain_lats, domain_lons = misc.get_domain_latlon(domain)
    filename = f"{path_in_model}{variable}_0.5x0.5_{date}.nc"

    with xr.open_dataset(filename) as ds:
        ds = ds.sel(latitude=domain_lats, longitude=domain_lons)
        ds = accumulate_along_dim(ds, acc_days, dim="time")
        out = ds[variable].load()

    return out


def fraction_model_events_greater_than_threshold(threshold_mm, forecast_dates, variable, path_in_forecast, path_in_hindcast, acc_days, domain):
    """
    Loops through all forecasts & hindcasts and computes, gridpointwise,
    the fraction of members with max(accumulated precip over lead time) > threshold_mm.

    Notes
    -----
    - Assumes input model precip is in meters (common for many reanalyses/models) so we convert to mm.
    - Uses max over 'time' for each member within each init to represent "worst-case during forecast window".
    - Produces a *fraction* by dividing by the total number of member-realizations processed.
    """

    count = None
    total_realizations = 0

    # loop through all inits
    for date in forecast_dates:
        print("reading forecast date:", date)

        forecast = read_accumulated_model_data(variable, date, path_in_forecast, acc_days, domain)
        hindcast = read_accumulated_model_data(variable, date, path_in_hindcast, acc_days, domain)

        # max over lead time window
        forecast_max = forecast.max(dim="time")
        hindcast_max = hindcast.max(dim="time")

        # convert to mm over acc_days (assumes data are in meters)
        forecast_mm = forecast_max * 1000.0
        hindcast_mm = hindcast_max * 1000.0

        # initialize output grid (once) from forecast grid
        if count is None:
            # make a 2D template (lat, lon) from forecast_mm by taking first member
            template = forecast_mm.isel(number=0, drop=True)
            template = template.drop_vars([v for v in template.coords if v not in ["latitude", "longitude"]], errors="ignore")
            count = xr.zeros_like(template, dtype="float32").rename("count")

        # exceedances for this init
        # forecast: sum over number
        count = count + (forecast_mm > threshold_mm).sum(dim="number")

        # hindcast: sum over number and hdate (if present)
        if "hdate" in hindcast_mm.dims:
            count = count + (hindcast_mm > threshold_mm).sum(dim=("number", "hdate"))
            total_realizations += int(forecast_mm.sizes["number"]) + int(hindcast_mm.sizes["number"]) * int(hindcast_mm.sizes["hdate"])
        else:
            # just in case hindcast files don't have hdate
            count = count + (hindcast_mm > threshold_mm).sum(dim="number")
            total_realizations += int(forecast_mm.sizes["number"]) + int(hindcast_mm.sizes["number"])

    if total_realizations == 0:
        raise RuntimeError("No realizations counted. Check input files and forecast_dates.")

    frac = (count / np.float32(total_realizations)).rename("count")
    frac.attrs["long_name"] = f"Fraction of members with {acc_days}-day accumulated precip > threshold"
    frac.attrs["threshold_mm"] = float(threshold_mm)
    frac.attrs["units"] = "1"

    return frac


def write_count_to_file(write2file, count, threshold_mm, forecast_dates, acc_days, path_out):
    if not write2file:
        return None

    # store threshold as a tiny DataArray for convenience
    thr = xr.DataArray(
        [float(threshold_mm)],
        dims=("time",),
        coords={"time": [pd.Timestamp("1970-01-01")]},
        name="threshold",
        attrs={"units": "mm", "description": f"User-defined threshold for {acc_days}-day accumulated precipitation"},
    )

    ds_out = xr.Dataset({"count": count, "threshold": thr})

    filename = (
        f"{path_out}xyt_model_events_with_more_{acc_days}_day_accumulated_precip_than_"
        f"{threshold_mm:g}mm_{forecast_dates[0]}-{forecast_dates[-1]}.nc"
    )
    ds_out.to_netcdf(filename)
    print("Wrote:", filename)


if __name__ == "__main__":

    forecast_dates = get_forecast_dates(forecast_date_range, option="mt")

    count = fraction_model_events_greater_than_threshold(
        rain_threshold_mm,
        forecast_dates,
        variable,
        path_in_forecast,
        path_in_hindcast,
        acc_days,
        domain,
    )

    write_count_to_file(write2file, count, rain_threshold_mm, forecast_dates, acc_days, path_out)
