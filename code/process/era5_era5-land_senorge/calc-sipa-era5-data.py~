"""
Create a date-selected replacement for sipa_preprocessed_era5_drammen.nc.

This script reproduces the core processing in the hans-oct repository's
preprocess_era5.py:

1. Read ERA5 data stored in S2S forecast and hindcast formats.
2. Set negative tp24 values to zero.
3. Calculate a latitude-area- and catchment-weighted Drammen mean.
4. Convert precipitation from metres to millimetres.
5. Convert forecast/hindcast records to a common daily ``date`` coordinate.
6. Combine the two sources and remove duplicate dates.
7. Retain only the inclusive user-selected valid-date range.
8. Write one NetCDF file containing ``tp24(date)``.

Edit the values in the User settings section, then run:

    python create_sipa_preprocessed_era5_drammen_date_range.py
"""

from __future__ import annotations

import os
from pathlib import Path

import numpy as np
import xarray as xr


# =============================================================================
# User settings
# =============================================================================

# Inclusive valid-date range to retain in the final NetCDF file.
START_DATE = "1957-01-01"
END_DATE = "2023-12-31"


# ERA5 source directories used by the original hans-oct preprocessing script.
ERA5_FORECAST_DIR = Path(
    "/nird/datapeak/NS9873K/etdu/processed/"
    "cf-Dunnsigouin_etal_2025/era5/s2s-model-format/"
    "forecast/daily/values/tp24"
)

ERA5_HINDCAST_DIR = Path(
    "/nird/datapeak/NS9873K/etdu/processed/"
    "cf-Dunnsigouin_etal_2025/era5/s2s-model-format/"
    "hindcast/daily/values/tp24"
)


# Drammen catchment weights used by source.py in the hans-oct repository.
CATCHMENT_WEIGHT_FILE = Path(
    "/nird/datapeak/NS9873K/etdu/processed/"
    "cf-Dunnsigouin_etal_2026/nve_catchment/"
    "weights_catchment_regine_drammen_era5_0.5x0.5.nc"
)


# Output file.
OUTPUT_FILE = Path(
    "sipa_preprocessed_era5_drammen.nc"
)


# Source-file selection.
FILE_PREFIX = "tp24_0.5x0.5"

# Optional initialization-date limits for source files.
# These limits are applied to the YYYY-MM-DD date encoded at the end of each
# source filename. Set either value to None to leave that side unrestricted.
SOURCE_INITIALIZATION_START = None
SOURCE_INITIALIZATION_END = "2023-06-26"

# Optional limit on the number of files read from each source directory.
# Use None to process all matching files.
MAX_FORECAST_FILES = None
MAX_HINDCAST_FILES = None


# Output behavior.
WRITE_TO_FILE = False
PRINT_DATES = False


# =============================================================================
# Fixed settings
# =============================================================================

VARIABLE = "tp24"
SPATIAL_DIMS = (
    "latitude",
    "longitude",
)


# =============================================================================
# Validation helpers
# =============================================================================


def validate_settings() -> None:
    """Validate user settings before reading large datasets."""

    start = np.datetime64(
        START_DATE,
        "D",
    )

    end = np.datetime64(
        END_DATE,
        "D",
    )

    if start > end:
        raise ValueError(
            "START_DATE must not be later than END_DATE."
        )

    for path, label in [
        (
            ERA5_FORECAST_DIR,
            "ERA5 forecast directory",
        ),
        (
            ERA5_HINDCAST_DIR,
            "ERA5 hindcast directory",
        ),
    ]:
        if not path.is_dir():
            raise FileNotFoundError(
                f"{label} not found: {path}"
            )

    if not CATCHMENT_WEIGHT_FILE.is_file():
        raise FileNotFoundError(
            "Catchment-weight file not found: "
            f"{CATCHMENT_WEIGHT_FILE}"
        )

    for value, label in [
        (
            MAX_FORECAST_FILES,
            "MAX_FORECAST_FILES",
        ),
        (
            MAX_HINDCAST_FILES,
            "MAX_HINDCAST_FILES",
        ),
    ]:
        if value is not None and value < 1:
            raise ValueError(
                f"{label} must be None or at least 1."
            )


# =============================================================================
# Filename helpers
# =============================================================================


def initialization_date_from_filename(
    filename: str,
) -> str:
    """Extract the trailing initialization date from a source filename."""

    return (
        Path(filename)
        .stem
        .split("_")[-1]
    )



def initialization_date_is_selected(
    initialization_date: str,
) -> bool:
    """Return True when a source-file initialization date is selected."""

    if (
        SOURCE_INITIALIZATION_START is not None
        and initialization_date < SOURCE_INITIALIZATION_START
    ):
        return False

    if (
        SOURCE_INITIALIZATION_END is not None
        and initialization_date > SOURCE_INITIALIZATION_END
    ):
        return False

    return True



def list_source_files(
    directory: Path,
    maximum_files: int | None,
) -> list[Path]:
    """List matching source files in initialization-date order."""

    filenames = sorted(
        filename
        for filename in os.listdir(
            directory
        )
        if filename.startswith(
            FILE_PREFIX
        )
    )

    selected = []

    for filename in filenames:
        initialization_date = (
            initialization_date_from_filename(
                filename
            )
        )

        if not initialization_date_is_selected(
            initialization_date
        ):
            continue

        selected.append(
            directory / filename
        )

    if maximum_files is not None:
        selected = selected[
            :maximum_files
        ]

    return selected


# =============================================================================
# Weighting and unit conversion
# =============================================================================


def load_catchment_weight() -> xr.DataArray:
    """Load the Drammen catchment-weight field into memory."""

    with xr.open_dataset(
        CATCHMENT_WEIGHT_FILE
    ) as ds_weights:
        if "catchment_weight" not in ds_weights:
            raise KeyError(
                "'catchment_weight' was not found in "
                f"{CATCHMENT_WEIGHT_FILE}. Available variables: "
                f"{list(ds_weights.data_vars)}"
            )

        catchment_weight = (
            ds_weights[
                "catchment_weight"
            ]
            .load()
        )

    return catchment_weight



def weighted_catchment_mean(
    ds: xr.Dataset,
    catchment_weight: xr.DataArray,
) -> xr.Dataset:
    """
    Reproduce source.weighted_mean for the Drammen catchment.

    Negative precipitation is set to zero, latitude-area weighting is combined
    with catchment weighting, and precipitation is converted from m to mm.
    """

    if VARIABLE not in ds:
        raise KeyError(
            f"'{VARIABLE}' was not found. Available variables: "
            f"{list(ds.data_vars)}"
        )

    missing_dims = [
        dim
        for dim in SPATIAL_DIMS
        if dim not in ds[VARIABLE].dims
    ]

    if missing_dims:
        raise ValueError(
            f"'{VARIABLE}' is missing spatial dimensions {missing_dims}. "
            f"Found dimensions: {ds[VARIABLE].dims}"
        )

    precipitation = xr.where(
        ds[VARIABLE] < 0,
        0,
        ds[VARIABLE],
    )

    latitude_weight = np.cos(
        np.deg2rad(
            ds["latitude"]
        )
    )

    combined_weight = (
        catchment_weight
        * latitude_weight
    )

    # Reindex the weight field to the data grid when coordinate ordering differs.
    combined_weight = combined_weight.reindex_like(
        precipitation.isel(
            {
                dim: 0
                for dim in precipitation.dims
                if dim not in SPATIAL_DIMS
            },
            drop=True,
        )
    )

    spatial_mean = precipitation.weighted(
        combined_weight
    ).mean(
        list(
            SPATIAL_DIMS
        )
    )

    spatial_mean = (
        spatial_mean
        * 1000.0
    )

    spatial_mean.name = VARIABLE
    spatial_mean.attrs = dict(
        ds[VARIABLE].attrs
    )
    spatial_mean.attrs["units"] = "mm"
    spatial_mean.attrs["description"] = (
        "Drammen catchment-weighted ERA5 daily precipitation"
    )

    return spatial_mean.to_dataset()


# =============================================================================
# Forecast-format processing
# =============================================================================


def preprocess_forecast_file(
    filename: Path,
    catchment_weight: xr.DataArray,
) -> xr.Dataset:
    """Convert one ERA5 forecast-format file to tp24(date)."""

    with xr.open_dataset(
        filename
    ) as ds_source:
        ds_mean = weighted_catchment_mean(
            ds_source,
            catchment_weight,
        ).load()

    if "time" not in ds_mean.dims:
        raise ValueError(
            f"Forecast file has no 'time' dimension: {filename}"
        )

    ds_mean = ds_mean.rename(
        {
            "time": "date",
        }
    )

    return ds_mean


# =============================================================================
# Hindcast-format processing
# =============================================================================


def make_hindcast_valid_dates(
    time_values: np.ndarray,
    hindcast_years: np.ndarray,
) -> np.ndarray:
    """
    Combine each forecast month/day with each hindcast year.

    Invalid combinations, such as 29 February in a non-leap year, become NaT.
    The order follows xarray's stack(time, hdate) order used by the original
    preprocessing script.
    """

    valid_dates = []

    for time_value in time_values:
        month_day = np.datetime_as_string(
            np.datetime64(
                time_value,
                "D",
            ),
            unit="D",
        )[5:]

        for hindcast_year in hindcast_years:
            date_string = (
                f"{int(hindcast_year):04d}-"
                f"{month_day}"
            )

            try:
                valid_date = np.datetime64(
                    date_string,
                    "ns",
                )
            except ValueError:
                valid_date = np.datetime64(
                    "NaT",
                    "ns",
                )

            valid_dates.append(
                valid_date
            )

    return np.asarray(
        valid_dates,
        dtype="datetime64[ns]",
    )



def preprocess_hindcast_file(
    filename: Path,
    catchment_weight: xr.DataArray,
) -> xr.Dataset:
    """Convert one ERA5 hindcast-format file to tp24(date)."""

    with xr.open_dataset(
        filename
    ) as ds_source:
        if "hdate" not in ds_source.coords:
            raise ValueError(
                f"Hindcast file has no 'hdate' coordinate: {filename}"
            )

        ds_mean = weighted_catchment_mean(
            ds_source,
            catchment_weight,
        ).load()

    hindcast_years = np.asarray(
        [
            int(
                str(value)[:4]
            )
            for value in ds_mean[
                "hdate"
            ].values
        ],
        dtype=int,
    )

    stacked = ds_mean.stack(
        date=(
            "time",
            "hdate",
        )
    )

    valid_dates = make_hindcast_valid_dates(
        time_values=ds_mean[
            "time"
        ].values,
        hindcast_years=hindcast_years,
    )

    stacked = stacked.assign_coords(
        date=(
            "date",
            valid_dates,
        )
    )

    stacked = stacked.where(
        ~np.isnat(
            stacked[
                "date"
            ]
        ),
        drop=True,
    )

    # Remove no-longer-useful coordinates inherited from the stacked source.
    stacked = stacked.drop_vars(
        [
            "time",
            "hdate",
        ],
        errors="ignore",
    )

    return stacked


# =============================================================================
# Source processing
# =============================================================================


def process_files(
    files: list[Path],
    source_name: str,
    processor,
    catchment_weight: xr.DataArray,
) -> xr.Dataset:
    """Process and concatenate one collection of ERA5 source files."""

    if not files:
        raise FileNotFoundError(
            f"No selected {source_name} files were found."
        )

    processed = []

    print()
    print(
        f"Processing {source_name} files"
    )
    print(
        "-" * (
            len(source_name)
            + 17
        )
    )

    for index, filename in enumerate(
        files,
        start=1,
    ):
        initialization_date = (
            initialization_date_from_filename(
                filename.name
            )
        )

        print(
            f"[{index:>4}/{len(files)}] "
            f"{filename.name} "
            f"({initialization_date})"
        )

        ds_processed = processor(
            filename,
            catchment_weight,
        )

        processed.append(
            ds_processed
        )

    combined = xr.concat(
        processed,
        dim="date",
    )

    combined = combined.sortby(
        "date"
    )

    combined = combined.drop_duplicates(
        dim="date",
        keep="first",
    )

    return combined


# =============================================================================
# Date selection and output
# =============================================================================


def select_valid_date_range(
    ds: xr.Dataset,
) -> xr.Dataset:
    """Select the inclusive user-specified valid-date range."""

    selected = ds.sel(
        date=slice(
            np.datetime64(
                START_DATE,
                "ns",
            ),
            np.datetime64(
                END_DATE,
                "ns",
            ),
        )
    )

    if selected.sizes.get(
        "date",
        0,
    ) == 0:
        raise ValueError(
            "No valid dates remain after selecting "
            f"{START_DATE} through {END_DATE}."
        )

    return selected



def add_output_metadata(
    ds: xr.Dataset,
) -> xr.Dataset:
    """Add concise provenance metadata to the output dataset."""

    ds = ds.copy()

    ds.attrs.update(
        {
            "title": (
                "Preprocessed ERA5 precipitation for the "
                "Drammen catchment"
            ),
            "valid_date_start": START_DATE,
            "valid_date_end": END_DATE,
            "catchment_weight_file": str(
                CATCHMENT_WEIGHT_FILE
            ),
            "forecast_source_directory": str(
                ERA5_FORECAST_DIR
            ),
            "hindcast_source_directory": str(
                ERA5_HINDCAST_DIR
            ),
            "processing": (
                "Negative tp24 set to zero; catchment and cosine-latitude "
                "weighted mean; converted from m to mm; forecast and "
                "hindcast records combined and deduplicated by valid date."
            ),
        }
    )

    return ds



def write_output(
    ds: xr.Dataset,
) -> None:
    """Write the selected dataset when requested."""

    if not WRITE_TO_FILE:
        print()
        print(
            "WRITE_TO_FILE is False; no NetCDF file was written."
        )
        return

    OUTPUT_FILE.parent.mkdir(
        parents=True,
        exist_ok=True,
    )

    encoding = {
        VARIABLE: {
            "zlib": True,
            "complevel": 4,
        }
    }

    ds.to_netcdf(
        OUTPUT_FILE,
        encoding=encoding,
    )

    print()
    print(
        "Wrote:",
        OUTPUT_FILE,
    )


# =============================================================================
# Main
# =============================================================================


if __name__ == "__main__":

    validate_settings()

    forecast_files = list_source_files(
        directory=ERA5_FORECAST_DIR,
        maximum_files=MAX_FORECAST_FILES,
    )

    hindcast_files = list_source_files(
        directory=ERA5_HINDCAST_DIR,
        maximum_files=MAX_HINDCAST_FILES,
    )

    print(
        "Selected settings"
    )
    print(
        "-----------------"
    )
    print(
        "Final valid dates:       ",
        f"{START_DATE} through {END_DATE}",
    )
    print(
        "Forecast source files:   ",
        len(
            forecast_files
        ),
    )
    print(
        "Hindcast source files:   ",
        len(
            hindcast_files
        ),
    )
    print(
        "Output file:             ",
        OUTPUT_FILE,
    )

    catchment_weight = load_catchment_weight()

    forecast = process_files(
        files=forecast_files,
        source_name="forecast-format",
        processor=preprocess_forecast_file,
        catchment_weight=catchment_weight,
    )

    hindcast = process_files(
        files=hindcast_files,
        source_name="hindcast-format",
        processor=preprocess_hindcast_file,
        catchment_weight=catchment_weight,
    )

    combined = xr.concat(
        [
            forecast,
            hindcast,
        ],
        dim="date",
    )

    combined = combined.sortby(
        "date"
    )

    combined = combined.drop_duplicates(
        dim="date",
        keep="first",
    )

    selected = select_valid_date_range(
        combined
    )

    selected = add_output_metadata(
        selected
    )

    print()
    print(
        "Output summary"
    )
    print(
        "--------------"
    )
    print(
        "First date:",
        str(
            selected.date.min().values
        ),
    )
    print(
        "Last date: ",
        str(
            selected.date.max().values
        ),
    )
    print(
        "Date count:",
        selected.sizes[
            "date"
        ],
    )

    if PRINT_DATES:
        print()
        print(
            "Dates in output"
        )
        print(
            "---------------"
        )

        for date in selected.date.values:
            print(
                np.datetime_as_string(
                    date,
                    unit="D",
                )
            )

    write_output(
        selected
    )
