# -------------------- IO helpers --------------------

def load_era5_data(filename_in_era5, hans_date="2023-08-08", x_days=2):
    """
    Load ERA5 tp24, form X-day rolling accumulation, convert to mm/Xday, select Hans day.
    """
    ds = xr.open_dataset(filename_in_era5)
    ds = ds.rolling(time=x_days, min_periods=x_days).sum()
    ds["tp24"] = ds["tp24"] * 1000.0  # m/Xday -> mm/Xday
    return ds.sel(time=hans_date)


def load_clim_std(filename_in_clim, month: int):
    """
    Load monthly climatological std of X-day accumulated precip (mm/Xday).
    Expects variable name 'std' and coordinate 'month' in the climatology file.
    """
    da_std = xr.open_dataset(filename_in_clim)["std"]
    return da_std.sel(month=month)


def load_streamflow(filename_in_streamflow):
    """Load streamflow dataset (expects time dimension)."""
    return xr.open_dataset(filename_in_streamflow)


# ---------------- Catchment helpers ----------------

def read_geojson(filepath: str) -> dict:
    with open(filepath, "r", encoding="utf-8") as f:
        return json.load(f)


def dissolve_polygon_geojson(gj: dict):
    """Dissolve all features into one (Multi)Polygon for clean borders."""
    geoms = [shape(feat["geometry"]) for feat in gj.get("features", [])]
    geom = unary_union(geoms)
    if geom.geom_type not in ("Polygon", "MultiPolygon"):
        raise ValueError(f"Expected Polygon/MultiPolygon, got {geom.geom_type}")
    return geom


def load_catchment_geom(filepath: str):
    gj = read_geojson(filepath)
    return dissolve_polygon_geojson(gj)


def plot_catchment_border(ax, catchment_geom, linewidth=2.0, color="tab:red", zorder=6):
    """Overlay catchment outline."""
    if catchment_geom is None:
        return

    if catchment_geom.geom_type == "Polygon":
        x, y = catchment_geom.exterior.xy
        ax.plot(x, y, linewidth=linewidth, color=color, transform=ccrs.PlateCarree(), zorder=zorder)
    elif catchment_geom.geom_type == "MultiPolygon":
        for poly in catchment_geom.geoms:
            x, y = poly.exterior.xy
            ax.plot(x, y, linewidth=linewidth, color=color, transform=ccrs.PlateCarree(), zorder=zorder)


# ---------------- Plot helpers ----------------

def _infer_edges_1d(centers: np.ndarray) -> np.ndarray:
    """Infer cell edges from 1D cell centers (assumes ~regular spacing)."""
    centers = np.asarray(centers)
    d = np.median(np.diff(centers))
    return np.concatenate(([centers[0] - d / 2], centers + d / 2))


def plot_outlet_marker(ax, lon, lat, label, text_dx=0.05, text_dy=0.05):
    """Plot a point + label for a catchment outlet (if coordinates are finite)."""
    if not (np.isfinite(lon) and np.isfinite(lat)):
        return

    ax.plot(
        lon, lat,
        marker="o",
        markersize=5,
        markeredgecolor="black",
        markerfacecolor="yellow",
        transform=ccrs.PlateCarree(),
        zorder=8,
    )
    ax.text(
        lon + text_dx,
        lat + text_dy,
        label,
        color="yellow",
        fontsize=10,
        transform=ccrs.PlateCarree(),
        zorder=9,
    )


def plot_panel_map_normalized_precip(
    ax,
    ds_era5: xr.Dataset,
    da_std: xr.DataArray,
    catchment_geoms,
    outlets,
    extent=(5, 13.0, 58, 63.0),
    var="tp24",
    eps=1e-12,
):
    """
    Panel (a): Hans X-day precip normalized by monthly climatological std.
    ratio = Hans_precip / std_month  (unitless, "number of std devs")
    """
    da_hans = ds_era5[var]  # mm/Xday on hans_date

    # Align grids defensively (usually identical, but safe)
    da_std_aligned = da_std
    try:
        da_std_aligned = da_std.interp_like(da_hans)
    except Exception:
        pass

    ratio = da_hans / (da_std_aligned + eps)

    lon = ds_era5["longitude"].values
    lat = ds_era5["latitude"].values

    lon_e = _infer_edges_1d(lon)
    lat_e = _infer_edges_1d(lat)

    z = ratio.values
    if lat_e[0] > lat_e[-1]:
        lat_e = lat_e[::-1]
        z = z[::-1, :]

    LON_E, LAT_E = np.meshgrid(lon_e, lat_e)

    m = ax.pcolormesh(
        LON_E, LAT_E, z,
        cmap="PiYG",
        shading="auto",
        vmin=0.0,
        vmax=10.0,
        transform=ccrs.PlateCarree(),
        zorder=1,
    )

    ax.add_feature(cfeature.COASTLINE, linewidth=0.7, zorder=3)
    ax.add_feature(cfeature.BORDERS, linewidth=0.5, zorder=3)
    ax.set_extent(extent, crs=ccrs.PlateCarree())

    # Catchment borders (distinguish by color if you want; here: same color for consistency)
    for geom in catchment_geoms:
        plot_catchment_border(ax, geom, linewidth=2.0, color="tab:red", zorder=6)

    # Outlet markers
    for name, meta in outlets.items():
        plot_outlet_marker(
            ax,
            lon=meta["lon"],
            lat=meta["lat"],
            label=name,
            text_dx=meta.get("text_dx", 0.05),
            text_dy=meta.get("text_dy", 0.05),
        )

    # Title with absolute date
    t = ds_era5.coords.get("time", None)
    tstr = ""
    if t is not None and np.ndim(t.values) == 0:
        tstr = str(pd.to_datetime(t.values).date())

    ax.set_title(f"a) Hans precip / monthly std (unitless)\n{tstr}".strip())

    return m


def _year_series_and_climstats_by_doy(da: xr.DataArray, year: int):
    """
    Returns:
      - x_dates (daily timestamps for the year)
      - y_year  (daily series for that year)
      - q_low, q_hi (2.5% and 97.5% across all years by day-of-year)
      - q_med (median across all years by day-of-year)
    """
    da = da.dropna("time")

    t0, t1 = f"{year}-01-01", f"{year}-12-31"
    x_dates = pd.date_range(t0, t1, freq="D")

    da_y = da.sel(time=slice(t0, t1))
    if da_y.sizes.get("time", 0) != len(x_dates):
        da_y = da_y.resample(time="1D").mean().sel(time=slice(t0, t1))
    y_year = da_y.values

    q = da.groupby("time.dayofyear").quantile([0.025, 0.5, 0.975], dim="time")

    doy = np.arange(1, 366)
    q_low = q.sel(quantile=0.025).sel(dayofyear=doy, drop=True).values
    q_med = q.sel(quantile=0.5).sel(dayofyear=doy, drop=True).values
    q_hi  = q.sel(quantile=0.975).sel(dayofyear=doy, drop=True).values

    return x_dates, y_year, q_low, q_hi, q_med


def plot_panel_streamflow(ax, ds_streamflow: xr.Dataset, year=2023, var="vannforing", panel_label="b", station_name=""):
    """Streamflow panel: 2023 series + climatological 95% interval + median."""
    da = ds_streamflow[var]
    x, y, lo, hi, med = _year_series_and_climstats_by_doy(da, year)

    ax.fill_between(x, lo, hi, alpha=0.25, label="95% interval over all years")
    ax.plot(x, med, linewidth=1.4, color="tab:red", label="Median over all years")
    ax.plot(x, y, linewidth=1.2, label=f"{year}")

    ax.set_title(f"{panel_label}) {station_name} streamflow {year}".strip())
    ax.set_ylabel("m³/s")


def _format_timeseries_axes(axes, year):
    """Uniform month ticks and x-limits for all time-series panels."""
    start = pd.Timestamp(f"{year}-01-01")
    end   = pd.Timestamp(f"{year}-12-31")

    for ax in axes:
        ax.xaxis.set_major_locator(mdates.MonthLocator())
        ax.xaxis.set_major_formatter(mdates.DateFormatter("%b"))
        ax.xaxis.set_minor_locator(mdates.MonthLocator())
        ax.set_xlim(start, end)
        ax.margins(x=0)
        ax.set_xlabel("Month")


# ---------------- Master plot ----------------

def plot_all_panels(
    ds_era5,
    da_std,
    ds_sf_bergheim,
    ds_sf_stromstoa,
    ds_sf_losna,
    catchment_geoms,
    outlets,
    year=2023,
    outfile=None,
    write2file=False,
):
    """
    Creates a 2x2 figure:
      (a) map: normalized precip + 3 catchments + 3 outlet markers
      (b-d) three streamflow panels (one per station)
    """
    proj = ccrs.LambertConformal(
        central_longitude=15,
        central_latitude=65,
        standard_parallels=(63, 70),
    )

    fig = plt.figure(figsize=(10 * 1.618, 10))
    gs = fig.add_gridspec(2, 2, wspace=0.15, hspace=0.2)

    ax_map = fig.add_subplot(gs[0, 0], projection=proj)
    ax_b   = fig.add_subplot(gs[0, 1])
    ax_c   = fig.add_subplot(gs[1, 0])
    ax_d   = fig.add_subplot(gs[1, 1])

    # --- Panel (a): map ---
    m = plot_panel_map_normalized_precip(
        ax_map,
        ds_era5=ds_era5,
        da_std=da_std,
        catchment_geoms=catchment_geoms,
        outlets=outlets,
        extent=extent,
    )

    # Colorbar to the LEFT of the map (matches your earlier style)
    divider = make_axes_locatable(ax_map)
    cax = divider.append_axes("left", size="7%", pad=0.25, axes_class=plt.Axes)
    cbar = fig.colorbar(m, cax=cax, orientation="vertical")
    cbar.set_label("standard deviations (unitless)")
    cax.yaxis.set_label_position("left")
    cax.yaxis.set_ticks_position("left")

    # --- Panels (b-d): streamflow ---
    plot_panel_streamflow(ax_b, ds_sf_bergheim,  year=year, var="vannforing", panel_label="b", station_name="Bergheim")
    plot_panel_streamflow(ax_c, ds_sf_stromstoa, year=year, var="vannforing", panel_label="c", station_name="Strømstøa")
    plot_panel_streamflow(ax_d, ds_sf_losna,     year=year, var="vannforing", panel_label="d", station_name="Losna")

    _format_timeseries_axes([ax_b, ax_c, ax_d], year=year)

    # One shared legend (pull from first time-series axis)
    handles_labels = {}
    for ax in (ax_b, ax_c, ax_d):
        h, l = ax.get_legend_handles_labels()
        for hh, ll in zip(h, l):
            handles_labels[ll] = hh

    ax_b.legend(
        list(handles_labels.values()),
        list(handles_labels.keys()),
        ncol=1,
        frameon=False,
        loc="upper left",
        fontsize=10,
    )

    if write2file and outfile:
        fig.savefig(outfile, bbox_inches="tight")

    plt.show()
    plt.close(fig)


